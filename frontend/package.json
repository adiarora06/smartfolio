{
  "name": "smartfolio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SmartFolio \u2014 component-based React frontend (Phase 2 conversion of the static prototype).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "icons": "npx --yes @capacitor/assets generate --ios --iconBackgroundColor '#101b33' --splashBackgroundColor '#101b33'",
    "ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^8.8.16",
    "@ionic/react-router": "^8.8.16",
    "ionicons": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.5.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
